{
  "name": "@app-x/frontend",
  "version": "0.0.1",
  "description": "frontend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch \"../../packages/webpack-config/\" --exec \"webpack serve --config ../../packages/webpack-config/dev.js\"",
    "build:dev": "webpack -c ../../packages/webpack-config/dev.js",
    "build:prod": "webpack -c ../../packages/webpack-config/prod.js",
    "build:test": "webpack -c ../../packages/webpack-config/test.js",
    "dev:simple": "webpack serve --config ../../packages/webpack-config/dev.js",
    "lint-staged": "lint-staged",
    "chk:prettier": "prettier --check ./src",
    "chk:eslint": "eslint ./src",
    "check": "run-s chk:prettier chk:eslint"
  },
  "browserslist": [
    "> 0.01%",
    "last 15 versions",
    "ie 8",
    "ie 9",
    "ie 10",
    "Firefox < 20",
    "Safari < 7",
    "Android 4"
  ],
  "dependencies": {
    "@app-x/cmd": "^0.0.1",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@mdi/font": "^7.4.47",
    "eventemitter3": "^5.0.4",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vuetify": "^4.1.4",
    "vuex": "^4.1.0"
  }
}
